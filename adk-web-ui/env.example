# Frontend (browser + Next.js API routes)
NEXT_PUBLIC_ADK_SERVER_URL=http://localhost:8000
NEXT_PUBLIC_ADK_LIST_AGENTS_CLIENT_TIMEOUT_MS=180000
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Google Maps Embed API key — used by the google_explorer_agent's map embeds.
# Restrict in Google Cloud Console to "Maps Embed API" only and your domains.
# Safe to expose: the embed URL is public; security comes from referer restrictions.
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY=

# Maps JavaScript API key — used by GuideMap for the Local Guide multi-marker
# overview map (interactive, multiple pins, click-to-select). Enable BOTH
# "Maps JavaScript API" and "Geocoding API" on this key (markers are geocoded
# client-side from address/name). Restrict by HTTP referrer to your domains.
# Without it, GuideMap silently no-ops; place cards and Maps links still work.
# Production AdvancedMarker maps should use a real Cloud Console Map ID
# (GuideMap currently uses Google's DEMO_MAP_ID for development).
NEXT_PUBLIC_GOOGLE_MAPS_JS_KEY=

# Optional footer links
NEXT_PUBLIC_GITHUB_URL=https://github.com/your-user
NEXT_PUBLIC_LINKEDIN_URL=https://www.linkedin.com/in/your-user
NEXT_PUBLIC_PERSONAL_URL=https://your-site.com

# Optional Google Analytics 4 Measurement ID (G-XXXXXXXX).
# Leave empty to skip loading GA. Consent Mode stays denied until the user Accepts.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXX

# Server-side (Next.js only; never exposed to browser)
ADK_LIST_APPS_TIMEOUT_MS=120000
ADK_LIST_APPS_MAX_ATTEMPTS=3
ADK_LIST_APPS_RETRY_DELAY_MS=2500

# Optional DB-backed features (sessions, stats, rate limiting, pageview analytics)
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Optional salt for hashing visitor IPs (falls back to AUTH_SECRET)
# ANALYTICS_IP_SALT=replace_with_a_long_random_secret

# Comma-separated emails allowed to open /analytics/ops (default: folkenai21@gmail.com)
# ANALYTICS_OPS_EMAILS=folkenai21@gmail.com

# Optional auth (Google OAuth)
GOOGLE_CLIENT_ID=your_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret_here
NEXTAUTH_URL=http://localhost:3000
AUTH_SECRET=replace_with_a_long_random_secret
# NEXTAUTH_SECRET=replace_with_a_long_random_secret
