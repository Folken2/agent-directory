# Frontend (browser + Next.js API routes)
# Server-only. Never NEXT_PUBLIC_: the browser must not learn the backend URL.
ADK_SERVER_URL=http://localhost:8000
# Shared secret sent as X-Internal-Token; must match the backend's ADK_INTERNAL_TOKEN.
ADK_INTERNAL_TOKEN=
# Skips boot-time env validation (CI builds only).
# SKIP_ENV_VALIDATION=true
NEXT_PUBLIC_ADK_LIST_AGENTS_CLIENT_TIMEOUT_MS=180000
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Google Maps Embed API key — used by the google_explorer_agent's map embeds.
# Restrict in Google Cloud Console to "Maps Embed API" only and your domains.
# Safe to expose: the embed URL is public; security comes from referer restrictions.
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY=

# Maps JavaScript API key — used by GuideMap for the Local Guide multi-marker
# overview map (interactive, multiple pins, click-to-select). Enable BOTH
# "Maps JavaScript API" and "Geocoding API" on this key (markers are geocoded
# client-side from address/name). Restrict by HTTP referrer to your domains.
# Without it, GuideMap silently no-ops; place cards and Maps links still work.
# Production AdvancedMarker maps should use a real Cloud Console Map ID
# (GuideMap currently uses Google's DEMO_MAP_ID for development).
NEXT_PUBLIC_GOOGLE_MAPS_JS_KEY=

# Optional footer links
NEXT_PUBLIC_GITHUB_URL=https://github.com/your-user
NEXT_PUBLIC_LINKEDIN_URL=https://www.linkedin.com/in/your-user
NEXT_PUBLIC_PERSONAL_URL=https://your-site.com

# Optional Google Analytics 4 Measurement ID (G-XXXXXXXX).
# Leave empty to skip loading GA. Consent Mode stays denied until the user Accepts.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXX

# Server-side (Next.js only; never exposed to browser)
ADK_LIST_APPS_TIMEOUT_MS=120000
ADK_LIST_APPS_MAX_ATTEMPTS=3
ADK_LIST_APPS_RETRY_DELAY_MS=2500

# Required: Postgres (Neon) — for sessions, stats, rate limiting, pageview analytics
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
# Local Docker database instead (npm run db:dev:up && npm run db:dev:reset):
# DATABASE_URL=postgres://postgres:postgres@db.localtest.me:5433/main

# Daily run limits (UTC). Defaults shown; override to change them.
# RATE_LIMIT_USER_DAILY=20
# RATE_LIMIT_ANON_DAILY=5
# RATE_LIMIT_ANON_IP_DAILY=15

# Daily pageview limit per IP (default: 3000)
# PAGEVIEW_IP_DAILY_LIMIT=3000

# Streaming timeouts (ms). Defaults shown; override to change them.
# STREAM_IDLE_TIMEOUT_MS=90000
# STREAM_MAX_DURATION_MS=600000

# Verbose [ADK Client] console logging for the streaming chat. Default off.
# NEXT_PUBLIC_DEBUG_STREAM=false

# Community writes (star/unstar, etc.) are disabled by default — they are
# currently forgeable client input. Set both to 'true' only once server-side
# verification is in place. The server flag gates the API route; the
# NEXT_PUBLIC_ flag gates whether the UI shows the write controls at all.
# COMMUNITY_WRITE_ENABLED=false
# NEXT_PUBLIC_COMMUNITY_WRITE_ENABLED=false

# Optional salt for hashing visitor IPs (falls back to AUTH_SECRET)
# ANALYTICS_IP_SALT=replace_with_a_long_random_secret

# Which request header carries the real client IP (used for per-IP rate limits
# and analytics). Clients can spoof x-forwarded-for, so pin the header your host's
# edge sets: e.g. `x-real-ip`, or `x-forwarded-for:last` for the hop the proxy
# appended. Verify with a spoofed-header request first. Unset = first
# x-forwarded-for entry, then x-real-ip.
# TRUSTED_IP_HEADER=x-forwarded-for:last

# Optional: origin the middleware posts server-side pageviews to. Defaults to
# http://127.0.0.1:$PORT when self-hosted and to the request origin on Vercel.
# ANALYTICS_INGEST_ORIGIN=http://127.0.0.1:3000

# Comma-separated emails allowed to open /analytics/ops (default: folkenai21@gmail.com)
# ANALYTICS_OPS_EMAILS=folkenai21@gmail.com

# Optional GA4 Data API for /analytics/ops acquisition panel (never required).
# Property ID is numeric (e.g. 123456789). Service account JSON must have Viewer
# access on the GA4 property. Absence shows a setup hint — does not error.
# GA4_PROPERTY_ID=
# GA4_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# Optional: error tracking
# Sentry DSN for server-side (Node/edge runtime) error capture. Leave empty to disable.
# SENTRY_DSN=
# Sentry DSN for browser error capture. Leave empty to disable.
# Read at BUILD time (inlined into the client bundle): set it before `npm run build`.
# NEXT_PUBLIC_SENTRY_DSN=
# Optional: server/edge trace sample rate between 0 and 1 (default 0.1).
# SENTRY_TRACES_SAMPLE_RATE=
# Needed only for source-map upload at build time.
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=

# Optional: where browsers send CSP violation reports (e.g. your Sentry project's
# security endpoint). Build-time.
# CSP_REPORT_URI=

# Required: Google OAuth
GOOGLE_CLIENT_ID=your_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret_here
NEXTAUTH_URL=http://localhost:3000
AUTH_SECRET=replace_with_a_long_random_secret
# NEXTAUTH_SECRET=replace_with_a_long_random_secret

# Builder blueprints (POST /api/blueprints). All optional.
# Webhook that receives {type:"blueprint.saved", email, blueprintName, markdown, ...}
# when a visitor saves a blueprint (Slack/Zapier/email relay). Unset = no notification.
BLUEPRINT_WEBHOOK_URL=
# Sent as "Authorization: Bearer <secret>" to the webhook.
BLUEPRINT_WEBHOOK_SECRET=
# https link shown after saving ("Book a call"). Unset = no link.
BLUEPRINT_BOOKING_URL=
# Daily save limits.
BLUEPRINT_SAVE_USER_DAILY=10
BLUEPRINT_SAVE_ANON_DAILY=3
BLUEPRINT_SAVE_ANON_IP_DAILY=10
